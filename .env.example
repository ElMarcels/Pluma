# =============================================================
# Pluma — Variables de entorno
# Copia este archivo a ".env.local" para desarrollo local.
# En producción se configuran en Vercel (Settings > Environment Variables).
# =============================================================

# -------------------------------------------------------------
# Base de datos (elige UNA de las dos opciones)
# -------------------------------------------------------------

# Opción A: Vercel Postgres (recomendada)
# POSTGRES_URL="postgres://user:password@host:5432/verceldb"

# Opción B: Vercel KV / Redis
# KV_URL="redis://default:token@host:port"
# KV_REST_API_URL="https://host/rest"
# KV_REST_API_TOKEN="..."
# KV_REST_API_READ_ONLY_TOKEN="..."

# -------------------------------------------------------------
# Autenticación del panel de administración
# -------------------------------------------------------------
# Contraseña maestra para crear/editar/borrar widgets.
# Mínimo recomendado: 12+ caracteres.
# ADMIN_PASSWORD="cambia-esta-contrasena"
# (alias aceptado: PASSWORD_MAESTRA)
